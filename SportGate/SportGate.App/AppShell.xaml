<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SportGate.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SportGate.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SportGate.App">

    <TabBar>

        <Tab Title="Cobros" Icon="ticket.png">
            <ShellContent ContentTemplate="{DataTemplate local:SellPage}" />
        </Tab>

        <Tab Title="Historial" Icon="clipboard.png">
            <ShellContent ContentTemplate="{DataTemplate local:HistoryPage}" />
        </Tab>
    </TabBar>

</Shell>
