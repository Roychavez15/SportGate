<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:SportGate.App.Converters"
             x:Class="SportGate.App.Views.HistoryPage"
             Title="Tickets del Día">
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:QrCodeConverter x:Key="QrCodeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <VerticalStackLayout Padding="12" Spacing="12">
        <!-- HEADER TOTAL DEL DÍA -->
        <Frame Padding="16"
               CornerRadius="12"
               HasShadow="True"
               BackgroundColor="#F5F5F5">

            <VerticalStackLayout>
                <Label Text="TOTAL RECAUDADO HOY"
                       FontSize="12"
                       TextColor="Gray" />

                <Label Text="{Binding DayTotal, StringFormat='{0:C}'}"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#2E7D32" />
            </VerticalStackLayout>

        </Frame>
        <CollectionView ItemsSource="{Binding Tickets}"
                SelectionMode="None"
                Margin="10">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="12"
                   Margin="6"
                   CornerRadius="12"
                   HasShadow="True">

                    <Grid ColumnDefinitions="80,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                        <!-- QR -->
                        <Image Grid.RowSpan="4"
                           WidthRequest="90"
                           HeightRequest="90"
                           Source="{Binding ShortCode, Converter={StaticResource QrCodeConverter}}" />

                        <!-- Código -->
                        <Label Grid.Column="1"
                           Text="{Binding ShortCode}"
                           FontAttributes="Bold"
                           FontSize="16" />

                        <!-- Tipo -->
                        <Label Grid.Column="1"
                           Grid.Row="1"
                           Text="{Binding entryTypePrice.Code}"
                           FontSize="13"
                           TextColor="Gray" />

                        <!-- Personas -->
                        <Label Grid.Column="1"
                           Grid.Row="2"
                           Text="{Binding PeopleCount, StringFormat='Personas: {0}'}"
                           FontSize="13" />

                        <!-- Fecha -->
                        <Label Grid.Column="1"
                           Grid.Row="3"
                           Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm:ss}'}"
                           FontSize="12"
                           TextColor="DarkGray" />

                        <!-- Total -->
                        <Label Grid.Column="1"
                           Grid.Row="4"
                           Text="{Binding TotalAmount, StringFormat='Total: {0:C}'}"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#4F2CCB" />

                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </VerticalStackLayout>
</ContentPage>