<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportGate.App.Views.SellPage"
             Title="Venta">

    <Grid RowDefinitions="*,Auto">

        <!-- CONTENIDO SCROLL -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="12" Spacing="12">

                <Label Text="Selecciona tipo de ingreso"
                       FontAttributes="Bold"/>

                <!-- ENTRY TYPES -->
                <CollectionView
                    ItemsSource="{Binding EntryTypes}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                    HeightRequest="220">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="LightGray"
                                    StrokeThickness="1"
                                    Padding="12"
                                    Margin="6">

                                <VerticalStackLayout>
                                    <Label Text="{Binding Description}"
                                           FontAttributes="Bold"/>

                                    <Label Text="{Binding BaseFee,
                                                  StringFormat='Base: {0:C}'}"
                                           FontSize="12"/>
                                </VerticalStackLayout>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Personas"
                       FontAttributes="Bold"/>

                <!-- 👇 AQUÍ VIVEN LOS STEPPERS -->
                <VerticalStackLayout
                    x:Name="PeopleContainer"
                    Spacing="8"
                    Padding="0,0,0,20"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER FIJO -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="12"
            BackgroundColor="White">

            <Label Text="{Binding Total,
                          StringFormat='Total: {0:C}'}"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Button Text="Generar ticket"
                    Command="{Binding GenerateTicketCommand}"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
